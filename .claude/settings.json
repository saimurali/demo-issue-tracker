{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck*)"
    ],
    "deny": [
      "Edit(package.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run typecheck",
            "timeout": 60,
            "statusMessage": "Running typecheck..."
          }
        ]
      }
    ]
  }
}